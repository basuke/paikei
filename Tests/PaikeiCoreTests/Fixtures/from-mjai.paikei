# from-mjai.paikei — MJAIイベントストリームから変換した局面
bakaze: S
kyoku: 3
honba: 0
kyotaku: 0
dora_markers: 1z
wall: 30

[self] seat=S
hand: 23m456p678s555z22m
river: 9p- 1z+ 3z- 8m+
score: 21000

[shimocha] seat=W
melds: chi(4'56m)
river: 1z- 9s- 2z+ 7p+^ 3s-
score: 28000

[toimen] seat=N
river: 5z- 1m+ 9m- 2p+ 4s+*
riichi: true
score: 26000

[kamicha] seat=E
river: 3z+ 2s- 8p-
score: 25000

claim_tile: 1m from=toimen

# 誰も鳴かず、続きをMJAI生ログのまま格納（self_actor=2: 自分が絶対座席2）
[stream] format=mjai self_actor=2
{"type":"tsumo","actor":1,"pai":"?"}
{"type":"dahai","actor":1,"pai":"N","tsumogiri":true}
{"type":"tsumo","actor":2,"pai":"6m"}
{"type":"dahai","actor":2,"pai":"2m","tsumogiri":false}
